# Copia este archivo como .env y completa tus datos. El .env NO se sube a git.

# ---- MySQL (lo comparten los dos paneles) ----
# Usa 127.0.0.1 y no "localhost": en Windows "localhost" prueba primero IPv6 y cada consulta tarda segundos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=numi

# ---- Claves para firmar la cookie de sesión de cada panel ----
# Genera cada una con:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=
DOCENTE_SECRET_KEY=

# ---- Conexión con la app Numi (repositorio app-educativa-medellin) ----
# URL del backend FastAPI de la app. Monitoreo técnico revisa /salud y /api/paquetes,
# y Gestión (panel docente) consulta la versión del paquete de conocimiento.
APP_API_URL=https://app-educativa-medellin-production-854b.up.railway.app
# Clave que el backend de la app envía en la cabecera X-Api-Key para usar /api/app/v1/...
# Vacía = el puente con la app queda apagado.
APP_API_KEY=
