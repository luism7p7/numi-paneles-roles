# Copia este archivo como .env y completa tus datos. El .env NO se sube a git.
# Si cambias el .env, reinicia la API: solo se lee al arrancar.

# ---- MySQL ----
# Usa 127.0.0.1 y no "localhost": en Windows "localhost" prueba primero IPv6 y cada consulta tarda segundos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=numi

# ---- Clave para firmar los tokens de inicio de sesión (JWT) ----
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# (También se acepta ADMIN_SECRET_KEY, el nombre que usaba el .env anterior.)
SECRET_KEY=
# Minutos que dura una sesión (por defecto 480 = 8 horas)
JWT_EXP_MINUTES=480

# ---- Quién puede llamar a la API desde el navegador ----
# Direcciones de los dos frontends separadas por comas. Vacío = localhost y 127.0.0.1 en los puertos 5173 y 5174.
CORS_ALLOWED_ORIGINS=

# ---- Conexión con la app Numi (repositorio app-educativa-medellin) ----
# Dirección del backend FastAPI de la app. Monitoreo técnico revisa /salud y /api/paquetes,
# y Gestión (panel docente) consulta la versión del paquete de conocimiento.
# En tu equipo: http://127.0.0.1:8000 ; en producción, la dirección pública del backend.
APP_API_URL=http://127.0.0.1:8000
# Clave que el backend de la app envía en la cabecera X-Api-Key para usar /api/app/v1/...
# Tiene que ser IGUAL a PANEL_API_KEY en el .env del backend de la app.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# Vacía = el puente con la app queda apagado y las actividades no llegan al celular.
APP_API_KEY=

# ---- Archivos subidos (opcional) ----
# Carpeta de las imágenes y audios de las actividades. Por defecto: api/uploads
UPLOADS_DIR=
